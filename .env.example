# ── Document storage (this device only) ──
# Uploaded documents, their original files, and your annotations are written to this machine's
# own disk. Nothing is uploaded anywhere.
#
# Defaults to .marginalia-store/ beside the project when run as a server. The packaged desktop
# app ignores this and uses the OS per-user application-data directory instead, so your library
# follows your user account.
MARGINALIA_STORE_DIR=

# Optional auto-expiry, OFF by default: documents are kept until you delete them from the
# library panel. Set to a positive number of days to have the sweeper retire them on a timer.
MARGINALIA_RETENTION_DAYS=0

# ── AI thematic analysis (optional) ──
# The only feature that sends anything off this machine, and only when you press the button in
# the reader. Leave blank and the rest of the app works exactly as before; the analysis panel
# will simply say no key is configured.
#
# Get a key from https://aistudio.google.com/apikey — "Create API key". Keys issued now begin
# with "AQ."; older ones begin with "AIza". Both are fine. A revoked or expired key is rejected
# with ACCESS_TOKEN_TYPE_UNSUPPORTED rather than anything clearer, so if you see that, make a
# new one rather than hunting for a config mistake.
#
# The "Look up a book" mode uses Google Search grounding, which has its own much smaller free
# allowance than ordinary requests — expect it to run out (429 RESOURCE_EXHAUSTED) long before
# analysing your own documents does.
GEMINI_API_KEY=

# Which model does the reading. Defaults to gemini-flash-latest, which follows Google's current
# Flash model — worth knowing that they retire the old ones: gemini-2.5-flash is already refused
# outright for keys created after its retirement. Pin a specific model here if you want to, and
# list what yours can actually reach with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=
